# npm **stops** on `engines` instead of warning past it.
#
# Measured on npm 11.13.0: an unsatisfiable `engines.node` produces `npm warn EBADENGINE` and exit 0, so the
# bound `package.json` declares was advice. Every other line of this repository's Definition of Done stops on
# what it checks; this one did not, and the interpreter running the pinned validator is exactly the thing a
# warning is least useful for — the run continues, on different bytes, and reports success.
#
# With this set, `npm ci` exits 1 naming the requirement and what is installed:
#   npm error notsup Required: {"node":">=24 <25"}
#   npm error notsup Actual:   {"node":"v25.x.x","npm":"11.13.0"}
engine-strict=true
